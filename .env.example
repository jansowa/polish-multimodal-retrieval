# OpenAI-compatible endpoint (OpenAI, vLLM, SGLang, etc.)
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=your-vllm-model-name

# Maximum number of simultaneous OpenAI API requests.
# Every request contains EXACTLY ONE benchmark example.
BATCH_SIZE=8
REQUEST_TIMEOUT=180
MAX_RETRIES=4
MAX_OUTPUT_TOKENS=8192
TEMPERATURE=0.0
# Optional second EN/PL review request per example; flags are exported in metadata.
# Roughly doubles API requests. Recommended for the v2 quality comparison run.
QUALITY_REVIEW=false
# Save compact source, draft, reviewed text and stage timings in metadata and
# review_comparison.jsonl. Use a separate RUN_NAME when enabling this.
SAVE_DRAFTS=false

# Output / cache
OUTPUT_DIR=./outputs
HF_CACHE_DIR=./.cache/huggingface
HF_TOKEN=
HF_STREAMING=true

# Images are resized/compressed on CPU before being sent as base64 data URLs.
IMAGE_MAX_SIDE=1280
IMAGE_JPEG_QUALITY=88
MAX_IMAGES_PER_RECORD=2
# Safety check for the server limit within ONE benchmark example.
# Examples are never split across requests.
MAX_IMAGES_PER_REQUEST=4

# M-BEIR keeps images separately (~very large). Required only for M-BEIR + WITH_IMAGE=true.
# Point this at the extracted M-BEIR image directory.
MBEIR_IMAGE_ROOT=

# Optional label separating different translation runs. If empty, a slug of OPENAI_MODEL is used.
RUN_NAME=
